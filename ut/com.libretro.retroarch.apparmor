{
  "policy_groups": [
    "audio",
    "video",
    "networking",
    "content_exchange",
    "keep-display-on"
  ],
  "read_path": [
    "/home/phablet/*",
    "/home/phablet/Documents/**",
    "/home/phablet/Downloads/**",
    "/home/phablet/Music/**",
    "/home/phablet/Pictures/**",
    "/home/phablet/Videos/**",
    "/media/**"
  ],
  "policy_version": 2404.1
}
