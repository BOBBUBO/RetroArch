include version.all

# Ubuntu Touch cross build: aarch64 (arm64) and armhf.
# Set CROSS_COMPILE, e.g. CROSS_COMPILE=aarch64-linux-gnu-
ifneq ($(filter aarch64-linux-gnu- arm-linux-gnueabihf-,$(CROSS_COMPILE)),$(CROSS_COMPILE))
  $(error You need an Ubuntu cross toolchain to build this package.)
endif

ifeq ($(CROSS_COMPILE),aarch64-linux-gnu-)
  TRIPLET := aarch64-linux-gnu
  DEBIAN_ARCH := arm64
  CLICK_ARCH := arm64
  ARCHFLAGS := -mcpu=cortex-a53
else
  TRIPLET := arm-linux-gnueabihf
  DEBIAN_ARCH := armhf
  CLICK_ARCH := armhf
  ARCHFLAGS := -mcpu=cortex-a9 -mtune=cortex-a53 -mfloat-abi=hard -mfpu=neon
  HAVE_NEON := 1
endif

STAGING_DIR ?= /usr/$(TRIPLET)

CC := $(CROSS_COMPILE)gcc
CXX := $(CROSS_COMPILE)g++

UTOUCH = 1
DEBUG ?= 0

CLICK_VERSION := $(shell grep '\#define PACKAGE_VERSION' version.all | sed -E 's/.*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/')
APP_PACKAGE_NAME ?= com.libretro.retroarch

HAVE_CLOUDSYNC = 1
HAVE_SCREENSHOTS = 1
HAVE_REWIND = 1
HAVE_7ZIP = 1
HAVE_ACCESSIBILITY = 1
HAVE_AL = 0
HAVE_ALSA ?= 1
HAVE_ANGLE = 0
HAVE_AUDIOIO = 0
HAVE_AUDIOMIXER = 1
HAVE_BLISSBOX = 0
HAVE_BSV_MOVIE = 1
HAVE_RFLAC = 1
HAVE_DSP_FILTER = 1
HAVE_VIDEO_FILTER = 1
HAVE_STATIC_VIDEO_FILTERS = 1
HAVE_STATIC_AUDIO_FILTERS = 1
HAVE_FILTERS_BUILTIN = 1
# The cleanroom network stack, as on the desktop builds: the crypto,
# the encrypted keychain, the TLS 1.2/1.3 client and the SMB2/3 client
# with Kerberos; plus the NFSv3/v4 client. Needs nothing but sockets.
HAVE_CRYPTO = 1
HAVE_KEYCHAIN = 1
HAVE_RETROSSL = 1
# The built-in SMB client needs a system libsmb2 that the Ubuntu archives
# do not ship for the cross target by default; keep it off here.
HAVE_RETROSMB = 0
HAVE_RETRONFS = 1
HAVE_C99 = 1
HAVE_CC = 1
HAVE_CC_RESAMPLER = 1
HAVE_NEAREST_RESAMPLER = 1
HAVE_CHD = 1
HAVE_RCHD = 1
HAVE_COMMAND = 1
HAVE_CXX = 1
HAVE_RMP3 = 1
HAVE_DYNAMIC = 1
HAVE_DYLIB = 1
HAVE_EGL ?= 1
HAVE_FREETYPE ?= 1
HAVE_GDI = 0
HAVE_GETADDRINFO = 1
HAVE_GETOPT_LONG = 1
HAVE_GLSL ?= 1
HAVE_GLSLANG = 0
HAVE_GLSLANG_HLSL = 0
HAVE_GLSLANG_OGLCOMPILER = 0
HAVE_GLSLANG_OSDEPENDENT = 0
HAVE_GLSLANG_SPIRV = 0
HAVE_GLSLANG_SPIRV_TOOLS = 0
HAVE_GLSLANG_SPIRV_TOOLS_OPT = 0
HAVE_HID = 1
HAVE_RMODTRACKER = 1
HAVE_IMAGEVIEWER = 1
HAVE_XKBCOMMON ?= 1
HAVE_LANGEXTRA = 1
HAVE_LIBRETRODB = 1
HAVE_MENU = 1
HAVE_MENU_COMMON = 1
HAVE_NETWORKING = 1
HAVE_IFINFO = 1
HAVE_NETWORK_CMD = 1
HAVE_NETPLAYDISCOVERY = 1
HAVE_NETWORKGAMEPAD = 1
HAVE_GFX_WIDGETS = 1
HAVE_MMAP = 1
HAVE_ONLINE_UPDATER = 1
HAVE_OPENGL = 0
HAVE_OPENGL1 = 0
HAVE_OPENGL_CORE = 0
HAVE_OPENGLES ?= 1
HAVE_OPENGLES3 ?= 1
HAVE_OPENGLES3_1 ?= 1
HAVE_OPENGLES3_2 ?= 1
HAVE_OPENSSL = 0
HAVE_OVERLAY = 1
HAVE_PULSE ?= 1
HAVE_RBMP = 1
HAVE_RJPEG = 1
HAVE_RPILED = 0
HAVE_RPNG = 1
HAVE_RWEBP = 1
HAVE_RDDS = 1
HAVE_RUNAHEAD = 1
HAVE_SDL = 0
HAVE_SDL2 ?= 1
HAVE_SDL3 = 0
HAVE_SHADERPIPELINE = 1
HAVE_STB_IMAGE = 1
HAVE_RVORBIS = 1
HAVE_STDIN_CMD = 1
HAVE_THREADS = 1
HAVE_TINYALSA ?= 0
HAVE_UDEV ?= 1
HAVE_RGUI = 1
HAVE_MATERIALUI = 0
HAVE_XMB = 1
HAVE_RZSTD = 1
HAVE_CONFIGFILE = 1
HAVE_PATCH = 1
HAVE_CHEATS = 1
HAVE_CHEEVOS = 1
HAVE_LIBSHAKE = 1
HAVE_UPDATE_ASSETS = 1
HAVE_UPDATE_CORES = 1
HAVE_UPDATE_CORE_INFO = 1
HAVE_CORE_INFO_CACHE = 1
HAVE_WAYLAND = 0
HAVE_WAYLAND_BACKPORT = 0
HAVE_64TO32BIT_BRIDGE = 0

OS = Linux
TARGET = retroarch

OBJ :=
LINK := $(CC)
DEF_FLAGS += -ffunction-sections -fdata-sections
DEF_FLAGS += -I. -Ideps -DUTOUCH=1 -MMD
DEF_FLAGS += -Wall -Wno-unused-variable
LIBS := -ldl -lrt -pthread

CFLAGS := $(ARCHFLAGS)
CFLAGS += -DUTOUCH_APP_ID=\"$(APP_PACKAGE_NAME)\"
CXXFLAGS := $(ARCHFLAGS) -fno-exceptions -fno-rtti -std=c++11 -D__STDC_CONSTANT_MACROS
ASFLAGS := $(ARCHFLAGS)
LDFLAGS := -Wl,-rpath=\$$ORIGIN/lib,--gc-sections
INCLUDE_DIRS = -I$(STAGING_DIR)/usr/include
LIBRARY_DIRS = -L$(STAGING_DIR)/usr/lib/$(TRIPLET) -L$(STAGING_DIR)/lib/$(TRIPLET)
DEFINES := -DRARCH_INTERNAL -D_FILE_OFFSET_BITS=64 -UHAVE_STATIC_DUMMY
DEFINES += -DHAVE_C99=1 -DHAVE_CXX=1 -D_GNU_SOURCE
DEFINES += -DHAVE_GETOPT_LONG=1 -DHAVE_DYNAMIC=1
DEFINES += -DHAVE_FILTERS_BUILTIN
DEFINES += -DHAVE_NETWORKING -DHAVE_IFINFO -DHAVE_ONLINE_UPDATER -DHAVE_UPDATE_ASSETS -DHAVE_UPDATE_CORES
DEFINES += -DHAVE_NETWORKGAMEPAD
DEFINES += -DHAVE_UPDATE_CORE_INFO
EGL_LIBS = -lEGL
OPENGLES_LIBS = -lGLESv2
XKBCOMMON_LIBS = -lxkbcommon
XKBCOMMON_CFLAGS = -DHAVE_XKBCOMMON=1
UDEV_LIBS = -ludev
UDEV_CFLAGS = -DHAVE_UDEV

ifeq ($(HAVE_FREETYPE),1)
  DEFINES += -DHAVE_FREETYPE
endif
ifeq ($(HAVE_ALSA),1)
  DEFINES += -DHAVE_ALSA
  LIBS += -lasound
endif
ifeq ($(HAVE_PULSE),1)
  DEFINES += -DHAVE_PULSE
  LIBS += -lpulse -lpulse-simple
endif
ifeq ($(HAVE_SDL2),1)
  DEFINES += -DHAVE_SDL2
endif
SDL2_CFLAGS := -I$(STAGING_DIR)/usr/include/SDL2
SDL2_LIBS ?= -lSDL2
FREETYPE_LIBS ?= -lfreetype
FREETYPE_CFLAGS ?=
FONTCONFIG_LIBS ?= -lfontconfig
PULSE_LIBS ?= -lpulse -lpulse-simple
PULSE_CFLAGS ?=
LIBS += -lpng -ljpeg -lz

OBJDIR_BASE := obj-unix

ifeq ($(DEBUG), 1)
   OBJDIR := $(OBJDIR_BASE)/debug
   DEF_FLAGS += -O0 -g -DDEBUG -D_DEBUG
else
   OBJDIR := $(OBJDIR_BASE)/release
   DEF_FLAGS += -O2 -DNDEBUG
endif

include Makefile.common

ifneq ($(GIT_VERSION),)
   DEFINES := $(filter-out -DGIT_VERSION=%,$(DEFINES))
   $(OBJDIR)/version_git.o: DEFINES += -DGIT_VERSION=$(GIT_VERSION)
endif

DEF_FLAGS += $(INCLUDE_DIRS)
LDFLAGS += $(CFLAGS) $(CXXFLAGS) $(DEF_FLAGS)
CFLAGS += $(DEF_FLAGS)
CXXFLAGS += $(DEF_FLAGS)

HEADERS = $(wildcard */*/*.h) $(wildcard */*.h) $(wildcard *.h)

ifneq ($(V),1)
        Q := @
endif

RARCH_OBJ := $(addprefix $(OBJDIR)/,$(OBJ))

all: $(TARGET) click

define INFO
ASFLAGS: $(ASFLAGS)
CC: $(CC)
CFLAGS: $(CFLAGS)
CPPFLAGS: $(CPPFLAGS)
CXX: $(CXX)
CXXFLAGS: $(CXXFLAGS)
DEFINES: $(DEFINES)
LDFLAGS: $(LDFLAGS)
LIBRARY_DIRS: $(LIBRARY_DIRS)
LIBS: $(LIBS)
LINK: $(LINK)
OBJCFLAGS: $(OBJCFLAGS)
RARCH_OBJ: $(RARCH_OBJ)
endef
export INFO

info:
ifneq ($(V),1)
	@echo "$$INFO"
endif

-include $(RARCH_OBJ:.o=.d)

SYMBOL_MAP := -Wl,-Map=output.map

$(TARGET): $(RARCH_OBJ)
	@$(if $(Q), $(shell echo echo LD $@),)
	$(Q)$(LINK) -o $@ $(RARCH_OBJ) $(LIBS) $(LDFLAGS) $(LIBRARY_DIRS)

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo CC $<),)
	$(Q)$(CC) $(CPPFLAGS) $(CFLAGS) $(DEFINES) -c -o $@ $<

$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo CXX $<),)
	$(Q)$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEFINES) -MMD -c -o $@ $<

$(OBJDIR)/%.o: %.m
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo OBJC $<),)
	$(Q)$(CXX) $(OBJCFLAGS) $(DEFINES) -MMD -c -o $@ $<

$(OBJDIR)/%.o: %.S $(HEADERS)
	@mkdir -p $(dir $@)
	@$(if $(Q), $(shell echo echo AS $<),)
	$(Q)$(CC) $(CFLAGS) $(ASFLAGS) $(DEFINES) -c -o $@ $<

STRIP ?= $(CROSS_COMPILE)strip

clean:
	@$(if $(Q), echo $@,)
	$(Q)rm -rf $(OBJDIR_BASE)
	$(Q)rm -f $(TARGET)
	$(Q)rm -f *.d
	$(Q)rm -rf ut/dist
	$(Q)rm -f ut/*.click

click: $(TARGET)
	rm -rf ut/dist
	mkdir -p ut/dist
	if [ "$(DEBUG)" = "1" ]; then :; else \
	  $(STRIP) $(TARGET); \
	fi
	cp $(TARGET) ut/dist/retroarch
	cp ut/icon.png ut/dist/com.libretro.retroarch.png
	cp ut/com.libretro.retroarch.desktop ut/dist/
	cp ut/com.libretro.retroarch.apparmor ut/dist/
	sed -e "s/@PACKAGE_VERSION@/$(CLICK_VERSION)/" \
	    -e "s/@CLICK_ARCH@/$(CLICK_ARCH)/" \
	    ut/manifest.json.in > ut/dist/manifest.json
	cd ut/dist && tar -cJf ../$(APP_PACKAGE_NAME)_$(CLICK_VERSION)_$(CLICK_ARCH).click \
	    manifest.json retroarch com.libretro.retroarch.desktop \
	    com.libretro.retroarch.apparmor com.libretro.retroarch.png
	@echo "Click package: ut/$(APP_PACKAGE_NAME)_$(CLICK_VERSION)_$(CLICK_ARCH).click"

.PHONY: all clean click info

print-%:
	@echo '$*=$($*)'
